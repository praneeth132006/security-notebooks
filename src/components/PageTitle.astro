---
/* Chapter pages get a small header above the title: which notebook this is,
   where you are in it, and a step bar of every chapter. Other pages render
   Starlight's default title. */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { href, lookup } from '../lib/notebooks';

const route = Astro.locals.starlightRoute;
const found = lookup(route.id);
const chapter = found?.chapter;
const notebook = found?.notebook;
---

{
	notebook && chapter && (
		<div class="chapter-meta">
			<a class="crumb" href={href(notebook.slug)}>
				{notebook.label}
			</a>
			<span class="sep" aria-hidden="true">/</span>
			<span>
				Chapter {found.index + 1} of {notebook.chapters.length}
			</span>
		</div>
	)
}

<Default />

{
	notebook && chapter && (
		<>
			<div class="facts">
				<span class="pill">{chapter.level}</span>
				{chapter.minutes > 0 && <span>{chapter.minutes} min read</span>}
			</div>
			<nav class="steps" aria-label={`Chapters in ${notebook.label}`}>
				{notebook.chapters.map((c, i) => (
					<a
						href={href(`${notebook.slug}/${c.slug}`)}
						data-chapter={`${notebook.slug}/${c.slug}`}
						aria-current={i === found.index ? 'step' : undefined}
						title={`${c.number}. ${c.title}`}
					>
						<span class="sr-only">
							Chapter {c.number}: {c.title}
						</span>
					</a>
				))}
			</nav>
			<span hidden data-current-chapter={route.id} />
		</>
	)
}

<script>
	import { markVisited, paint } from '../scripts/progress';

	const current = document.querySelector<HTMLElement>('[data-current-chapter]');
	if (current) markVisited(current.dataset.currentChapter!);
	paint();
</script>

<style>
	.chapter-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.crumb {
		color: var(--sl-color-text-accent);
		text-decoration: none;
		font-weight: 500;
	}
	.crumb:hover {
		text-decoration: underline;
	}
	.chapter-meta + :global(h1) {
		margin-top: 0.25rem;
	}
	.facts {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.pill {
		padding: 0.1rem 0.6rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
	}
	.steps {
		display: flex;
		gap: 4px;
		margin-top: 1.25rem;
	}
	.steps a {
		flex: 1;
		height: 4px;
		border-radius: 2px;
		background: var(--sl-color-gray-5);
		transition: background-color 0.2s, transform 0.2s;
	}
	.steps a[data-visited] {
		background: var(--sl-color-accent-low);
		box-shadow: inset 0 0 0 1px var(--sl-color-accent);
	}
	.steps a[aria-current='step'] {
		background: var(--sl-color-accent);
		box-shadow: none;
	}
	.steps a:hover {
		transform: scaleY(1.6);
	}
</style>
