---
/* Home page roadmap: five phases in learning order, each listing its
   notebooks. Phases fade in and the spine draws itself as you scroll;
   reading progress from this browser fills each notebook's bar. */
import { formatMinutes, href, phases } from '../lib/notebooks';

const stages = phases();
---

<section id="roadmap" class="roadmap not-content" aria-label="Learning roadmap">
	<ol>
		{
			stages.map((stage, i) => (
				<li class="stage" data-reveal>
					<div class="marker" aria-hidden="true">
						{i + 1}
					</div>
					<div class="body">
						<h2>{stage.name}</h2>
						<p class="blurb">{stage.blurb}</p>
						<div class="cards">
							{stage.books.map((book) => (
								<a
									class="card"
									href={href(book.slug)}
									data-notebook={book.slug}
									data-chapters={book.chapters.map((c) => `${book.slug}/${c.slug}`).join(' ')}
								>
									<span class="title">{book.label}</span>
									<span class="meta">
										<span data-progress-label>{book.chapters.length} chapters</span>
										<span aria-hidden="true">·</span>
										<span>{formatMinutes(book.chapters.reduce((t, c) => t + c.minutes, 0))}</span>
									</span>
									<span class="bar" aria-hidden="true" />
								</a>
							))}
						</div>
					</div>
				</li>
			))
		}
	</ol>
</section>

<script>
	import { paint } from '../scripts/progress';

	paint();

	const stages = document.querySelectorAll<HTMLElement>('[data-reveal]');
	if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
		stages.forEach((s) => s.classList.add('shown'));
	} else {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						e.target.classList.add('shown');
						io.unobserve(e.target);
					}
				}
			},
			{ rootMargin: '0px 0px -10% 0px' }
		);
		stages.forEach((s) => io.observe(s));
	}
</script>

<style>
	.roadmap {
		scroll-margin-top: 5rem;
		max-width: 56rem;
		margin: 0 auto;
	}
	ol {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.stage {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: 1.25rem;
		padding-bottom: 2.75rem;
		margin: 0;
	}
	/* The spine between markers, drawn top to bottom when the stage appears. */
	.stage:not(:last-child)::before {
		content: '';
		position: absolute;
		left: calc(1.25rem - 1px);
		top: 2.75rem;
		bottom: 0.25rem;
		width: 2px;
		border-radius: 1px;
		background: var(--sl-color-gray-5);
		transform-origin: top;
		transform: scaleY(0);
		transition: transform 0.8s ease 0.2s;
	}
	.marker {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-accent-high);
		background: var(--sl-color-accent-low);
		border: 1px solid var(--sl-color-accent);
		transform: scale(0.6);
		opacity: 0;
		transition: transform 0.4s ease, opacity 0.4s ease;
	}
	.body {
		opacity: 0;
		transform: translateY(12px);
		transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s;
	}
	.shown .marker {
		transform: none;
		opacity: 1;
	}
	.shown .body {
		opacity: 1;
		transform: none;
	}
	.shown::before {
		transform: scaleY(1) !important;
	}
	h2 {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-h3);
		color: var(--sl-color-white);
	}
	.blurb {
		margin: 0.35rem 0 1rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
		gap: 0.75rem;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.85rem 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		text-decoration: none;
		overflow: hidden;
		transition: border-color 0.15s, transform 0.15s;
	}
	.card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
	}
	.title {
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.meta {
		display: flex;
		gap: 0.35rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.bar {
		position: absolute;
		left: 0;
		bottom: 0;
		height: 3px;
		width: calc(var(--done, 0) * 100%);
		background: var(--sl-color-accent);
		transition: width 0.6s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.stage::before,
		.marker,
		.body,
		.card,
		.bar {
			transition: none;
		}
	}
</style>
